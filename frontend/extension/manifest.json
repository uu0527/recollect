{
  "manifest_version": 3,
  "name": "ReCollect 拾遗 - 收藏激活助手",
  "version": "0.2.6",
  "description": "读取小红书收藏列表并采集笔记内容，整理为可导入知识库的本地文件。仅本地处理，不上传任何数据。",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReCollect 拾遗"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
