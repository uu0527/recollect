# ============================================================
# ReCollect 环境配置示例（模板）
# 用法：
#   1. cp .env.example .env
#   2. 在 .env 中填写真实 API Key（.env 已被 gitignore，不会提交）
#   3. 运行 python scripts/check_env.py 验证配置
# ============================================================

# ===== Provider 选择 =====
# 可选: mock / deepseek / qwen / zhipu / openai / kimi
RECOLLECT_P2_PROVIDER=deepseek
RECOLLECT_P3_PROVIDER=deepseek
RECOLLECT_P5_PROVIDER=zhipu
# P6 检索问答（当前不调 LLM，预留）
RECOLLECT_P6_PROVIDER=zhipu

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== Qwen (DashScope) =====
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# Qwen Vision（视觉专用，仅视觉任务触发；DASHSCOPE_API_KEY 缺失时回退 QWEN_API_KEY）
DASHSCOPE_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-plus

# ===== Zhipu (GLM) =====
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ===== OpenAI（预留）=====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Kimi（预留）=====
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# ===== Feishu Bitable（P4 写库）=====
# 4 项齐全后自动切真实模式，缺失自动降级 Mock
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_TOKEN=
FEISHU_BITABLE_TABLE_ID=
